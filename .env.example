APP_NAME=alloBos
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
# 127.0.0.1 bila aplikasi berada di belakang nginx di server yang sama.
APP_BIND=0.0.0.0
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Lencana Demo di samping logo. SEED_DEMO=true mengisi data demo bila basis data masih kosong.
APP_DEMO=true
SEED_DEMO=true
DEMO_PASSWORD=

# Matikan bila server belum punya SMTP, supaya akun baru tidak tertahan di verifikasi email.
REQUIRE_EMAIL_VERIFICATION=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=allobos
DB_USERNAME=allobos
DB_PASSWORD=
# Hanya dipakai docker-compose untuk wadah mysql.
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Contoh untuk Resend SMTP: MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_HOST=smtp.resend.com,
# MAIL_PORT=465, MAIL_USERNAME=resend, MAIL_PASSWORD=<kunci API Resend>.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@allobos.example"
MAIL_FROM_NAME="${APP_NAME}"

# Gemini. Boleh beberapa kunci dipisah koma, dipakai bergiliran saat terkena batas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Dicoba berurutan bila model utama tidak tersedia.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest
BOSS_SESSIONS_PER_DAY=5

# Suara Bos Allo lewat Speechify (suara Henry). Kosongkan untuk memakai suara bawaan peramban.
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE=henry
SPEECHIFY_MODEL=simba-3.5

# Blockchain (jaringan EVM). Bawaan masa lomba: Polygon Amoy.
CHAIN_NAME="Polygon Amoy"
CHAIN_ID=80002
CHAIN_TESTNET=true
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_EXPLORER_URL=https://amoy.polygonscan.com
CHAIN_MIN_BALANCE=0.05
CERT_CONTRACT_ADDRESS=
# Kunci privat dompet penerbit. Hanya di server, jangan pernah di-commit.
ISSUER_PRIVATE_KEY=
# Garam untuk sidik nama penerima. Isi string acak panjang dan jangan diganti setelah ada sertifikat.
CERT_HASH_SALT=

VITE_APP_NAME="${APP_NAME}"
